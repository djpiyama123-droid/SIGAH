# SIGAB — Variables de entorno (plantilla). Copia a .env y rellena valores reales.
# El .env real NUNCA se versiona (ver .gitignore). No hay defaults hardcodeados.

# ── Base de datos MySQL ───────────────────────────────────────
DB_ROOT_PASS=          # password de root MySQL (solo instalación/setup)
DB_USER=sigab_user
DB_PASS=               # password del usuario de aplicación (OBLIGATORIO)
DB_NAME=sigab

# Variables que lee el backend (config.py) — mismas credenciales con prefijo SIGAB_
SIGAB_DB_HOST=127.0.0.1
SIGAB_DB_PORT=3306
SIGAB_DB_USER=sigab_user
SIGAB_DB_PASS=         # = DB_PASS (OBLIGATORIO; el backend no arranca sin esto)
SIGAB_DB_NAME=sigab

# ── Autenticación / seed ──────────────────────────────────────
SIGAB_JWT_SECRET=      # genera con: python -c "import secrets;print(secrets.token_urlsafe(48))"
SIGAB_ADMIN_PASSWORD=  # password del admin inicial (seed_admin.py / deploy)
SIGAB_AUDIT_PASSWORD=  # password del usuario de auditoría (scratch/seed_audit_user.py)

# ── IA en nube (MiniMax, fallback del edge Ollama) ────────────
SIGAB_MINIMAX_API_KEY=
SIGAB_PUBLIC_BASE_URL=http://localhost:5173
